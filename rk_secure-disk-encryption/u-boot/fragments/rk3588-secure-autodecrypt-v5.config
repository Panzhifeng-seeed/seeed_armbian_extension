# vendor-next (rockchip-linux/u-boot v5, binman flow) secure-rootfs tier.
# Unsigned bootchain: no FIT_SIGNATURE/SPL_FIT_SIGNATURE here — with
# FIT_SIGNATURE=y the v5 rockchip-common.h narrows bootcmd to "boot_fit;"
# alone, which breaks the bootstd default-env contract (the OTA env check
# requires the bootflow leg) and buys nothing before the secure-boot tier.
# The tee-1 FIT node is packed by binman from TEE=tee.bin (staged by
# rk_secure_boot_stage_bl32_binman); CMD_BOOT_FIT is default-on in the v5
# tree and the bootstd bootcmd chain already leads with boot_fit.
CONFIG_USE_BOOTARGS=y
# plymouth.ignore-serial-consoles: the boot.scr path adds it to every plain
# cmdline (boot-seeed-rk35xx.cmd consoleargs); without it plymouthd attaches
# to the active serial console (ttyFIQ0) and races the getty for input bytes,
# which terminates login's password read after the first keystroke. No
# loglevel — the 2017.09 secure baseline boots at the kernel default console
# level (verbose serial) and the secure path keeps that.
CONFIG_BOOTARGS="earlycon=uart8250,mmio32,0xfeb50000 console=ttyFIQ0 irqchip.gicv3_pseudo_nmi=0 plymouth.ignore-serial-consoles root=/dev/mapper/armbian-root rw rootwait"
